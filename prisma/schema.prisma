// MZ EXPORT - Gestion Commerciale
// Schema Prisma - PostgreSQL
// Tous les montants monetaires utilisent Decimal (jamais de float JS).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  MANAGER
  USER
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CHEQUE
  OTHER
}

/// NONE  : facture sans TVA (export exonere) -> aucune ligne TVA affichee
/// ZERO  : TVA applicable au taux 0 % -> ligne TVA affichee a 0
/// RATE  : TVA appliquee au taux defini sur la facture
enum VatMode {
  NONE
  ZERO
  RATE
}

/// Nature de ce qu'un fournisseur facture. Sert a ventiler les achats dans le
/// resultat sans avoir a classer chaque facture : un fournisseur ne melange pas
/// les natures chez MZ EXPORT.
enum SupplierNature {
  /// Achat de marchandise : la fouta.
  FOUTA
  /// HERITAGE. Les societes de transport avaient ete saisies comme des
  /// fournisseurs avant l'existence du module Transport (`Carrier` /
  /// `TransportInvoice`). La valeur est conservee pour ne pas casser
  /// d'historique, mais elle n'est plus proposee a la saisie.
  TRANSPORT
  /// Tout le reste : fournitures, services, frais divers.
  DIVERS
}

/// Nature d'une piece jointe. MZ EXPORT est intermediaire : la plupart de ces
/// documents sont RECUS de tiers (fournisseur, transporteur, banque) et non
/// produits par l'application. Ce sont eux qui ont valeur probante.
enum DocumentKind {
  /// Facture d'achat scannee, telle qu'emise par le fournisseur.
  SUPPLIER_INVOICE
  /// Bon de livraison remis par la societe de transport.
  DELIVERY_NOTE
  /// Facture de la societe de transport.
  TRANSPORT_INVOICE
  /// Justificatif de reglement : cheque, avis de virement, recu.
  PAYMENT_PROOF
  /// Piece douaniere : declaration, certificat d'origine, EUR.1...
  CUSTOMS
  OTHER
}

// ---------------------------------------------------------------------------
// Utilisateurs & securite
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(USER)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  invoices          Invoice[]          @relation("InvoiceCreatedBy")
  payments          Payment[]          @relation("PaymentCreatedBy")
  purchases         Purchase[]         @relation("PurchaseCreatedBy")
  purchasePayments  PurchasePayment[]  @relation("PurchasePaymentCreatedBy")
  transportInvoices TransportInvoice[] @relation("TransportInvoiceCreatedBy")
  transportPayments TransportPayment[] @relation("TransportPaymentCreatedBy")
  stockMovements    StockMovement[]
  auditLogs         AuditLog[]
  documents         Document[]         @relation("DocumentUploadedBy")

  @@map("users")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userEmail String
  action    String
  entity    String
  entityId  String?
  reference String?
  details   Json?
  ip        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Parametres societe (table a ligne unique, id = "company")
// ---------------------------------------------------------------------------

model Company {
  id        String @id @default("company")
  name      String
  legalForm String @default("")

  capital         Decimal @default(0) @db.Decimal(18, 3)
  capitalCurrency String  @default("TND")

  taxId         String @default("") // Matricule fiscal
  tradeRegister String @default("") // Registre de commerce
  activity      String @default("")

  addressLine1 String @default("")
  addressLine2 String @default("")
  postalCode   String @default("")
  city         String @default("")
  country      String @default("Tunisie")

  phone   String @default("")
  phone2  String @default("")
  fax     String @default("")
  email   String @default("")
  website String @default("")

  bankName    String @default("")
  bankAgency  String @default("")
  bankAccount String @default("")
  iban        String @default("")
  swift       String @default("")

  logoPath String @default("")

  // Valeurs par defaut appliquees aux nouvelles factures
  defaultCurrency     String  @default("EUR")
  defaultVatMode      VatMode @default(NONE)
  defaultVatRate      Decimal @default(0) @db.Decimal(6, 3)
  defaultStampDuty    Decimal @default(0) @db.Decimal(18, 2)
  defaultStampLabel   String  @default("Timbre fiscal")
  defaultPaymentTerms String  @default("")
  defaultIncoterm     String  @default("")
  defaultOrigin       String  @default("")

  headerNote    String @default("")
  paymentNotice String @default("")
  legalMentions String @default("")
  footerText    String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("company_settings")
}

// ---------------------------------------------------------------------------
// Devises
// ---------------------------------------------------------------------------

model Currency {
  code     String  @id // EUR, TND
  name     String
  symbol   String
  decimals Int     @default(2)
  isActive Boolean @default(true)

  customers         Customer[]
  invoices          Invoice[]
  payments          Payment[]
  suppliers         Supplier[]
  purchases         Purchase[]
  purchasePayments  PurchasePayment[]
  carriers          Carrier[]
  transportInvoices TransportInvoice[]
  transportPayments TransportPayment[]
  exchangeRates     ExchangeRate[]

  @@map("currencies")
}

// ---------------------------------------------------------------------------
// Taux de change vers le dinar tunisien
// ---------------------------------------------------------------------------

/// Historique des taux de change. Un taux est valable a partir de `validFrom`
/// jusqu'au taux suivant de la meme devise.
///
/// REGLE : ces taux ne servent qu'a PROPOSER une valeur par defaut au moment
/// de la saisie. Une fois le document enregistre, il porte son propre taux
/// (`exchangeRateTnd`) et ne depend plus de cette table : modifier un taux
/// ici ne reecrit JAMAIS l'historique comptable.
model ExchangeRate {
  id           String   @id @default(cuid())
  currencyCode String
  /// 1 unite de `currencyCode` = `rateToTnd` dinars tunisiens.
  rateToTnd    Decimal  @db.Decimal(18, 6)
  /// Date d'entree en vigueur (incluse).
  validFrom    DateTime @db.Date
  source       String   @default("") // Ex. "BCT", "saisie manuelle"
  note         String   @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  currency Currency @relation(fields: [currencyCode], references: [code], onDelete: Cascade)

  @@unique([currencyCode, validFrom])
  @@index([currencyCode, validFrom])
  @@map("exchange_rates")
}

// ---------------------------------------------------------------------------
// Numerotation des documents (sequence atomique)
// ---------------------------------------------------------------------------

model InvoiceSequence {
  id          String  @id @default(cuid())
  key         String  @unique // "SALE"
  label       String
  prefix      String  @default("FAC-V-")
  suffix      String  @default("")
  padding     Int     @default(4)
  nextNumber  Int     @default(1)
  resetYearly Boolean @default(false)
  year        Int?
  includeYear Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("invoice_sequences")
}

// ---------------------------------------------------------------------------
// Clients
// ---------------------------------------------------------------------------

model Customer {
  id           String @id @default(cuid())
  code         String @unique
  companyName  String // Raison sociale
  firstName    String @default("")
  lastName     String @default("")
  contactName  String @default("")
  contactPhone String @default("")
  contactEmail String @default("")

  addressLine1 String @default("")
  addressLine2 String @default("")
  postalCode   String @default("")
  city         String @default("")
  country      String @default("")

  phone String @default("")
  email String @default("")

  taxId     String @default("") // Matricule fiscal
  siret     String @default("")
  vatNumber String @default("") // TVA intracommunautaire — « C.F / P.IVA » chez les clients italiens

  /// Numero EORI, identifiant douanier de l'operateur dans l'Union europeenne.
  /// Distinct du SIRET et du numero de TVA : un client peut porter les trois.
  /// Son absence sur la facture bloque le dedouanement a l'arrivee.
  eori String @default("")

  paymentTerms String @default("")
  currencyCode String @default("EUR")

  // Adresse de livraison par defaut (reprise sur la facture)
  deliveryAddress String @default("")
  deliveryCountry String @default("")

  /// Incoterm habituel de ce client, repris sur ses nouvelles factures.
  ///
  /// Sert a inscrire une regle commerciale durable plutot qu'a la reprendre de
  /// memoire a chaque facture. Un client en EXW enleve la marchandise lui-meme :
  /// aucun transport n'est a notre charge, et l'absence de facture de
  /// transporteur sur son expedition est NORMALE, pas un oubli.
  defaultIncoterm String @default("")

  notes    String  @default("")
  isDemo   Boolean @default(false)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  currency Currency  @relation(fields: [currencyCode], references: [code])
  invoices Invoice[]

  @@index([companyName])
  @@map("customers")
}

// ---------------------------------------------------------------------------
// Produits
// ---------------------------------------------------------------------------

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]

  @@map("categories")
}

model Product {
  id          String @id @default(cuid())
  reference   String @unique
  sku         String @default("")
  designation String
  description String @default("")
  unit        String @default("PCS")

  categoryId String?

  salePriceEur     Decimal @db.Decimal(18, 4)
  purchasePriceTnd Decimal @default(0) @db.Decimal(18, 4)

  /// Le produit est-il suivi en stock ? (false pour un service / une prestation)
  trackStock    Boolean @default(true)
  stockQuantity Decimal @default(0) @db.Decimal(18, 3)
  minStock      Decimal @default(0) @db.Decimal(18, 3)

  vatMode VatMode @default(NONE)
  vatRate Decimal @default(0) @db.Decimal(6, 3)

  // Donnees export
  ngp             String  @default("") // Code douanier
  originCountry   String  @default("")
  unitWeightKg    Decimal @default(0) @db.Decimal(12, 3)
  lengthCm        Decimal @default(0) @db.Decimal(10, 2)
  widthCm         Decimal @default(0) @db.Decimal(10, 2)
  heightCm        Decimal @default(0) @db.Decimal(10, 2)
  unitsPerPackage Int     @default(0)

  isDemo   Boolean @default(false)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category       Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  items          InvoiceItem[]
  purchaseItems  PurchaseItem[]
  stockMovements StockMovement[]

  @@index([designation])
  @@map("products")
}

// ---------------------------------------------------------------------------
// Factures de vente (export, EUR)
// ---------------------------------------------------------------------------

model Invoice {
  id     String        @id @default(cuid())
  number String        @unique
  status InvoiceStatus @default(DRAFT)

  customerId String
  date       DateTime  @db.Date
  dueDate    DateTime? @db.Date

  currencyCode String @default("EUR")

  paymentTerms String @default("")

  // Livraison
  deliveryAddress String @default("")
  deliveryCountry String @default("")

  // Informations export
  ngp               String  @default("")
  originCountry     String  @default("")
  packageCount      Int     @default(0)
  packageType       String  @default("")
  packageDimensions String  @default("")
  grossWeightKg     Decimal @default(0) @db.Decimal(12, 3)
  netWeightKg       Decimal @default(0) @db.Decimal(12, 3)
  incoterm          String  @default("")
  transportMode     String  @default("")
  departurePort     String  @default("")
  destination       String  @default("")
  orderReference    String  @default("")

  /// Numero de domiciliation bancaire de l'operation d'export.
  /// PAS unique : une meme domiciliation peut porter plusieurs factures.
  domiciliationRef String @default("")

  // Montants (devise = currencyCode)
  goodsTotal    Decimal @default(0) @db.Decimal(18, 2)
  discountTotal Decimal @default(0) @db.Decimal(18, 2)

  /// true  : les frais (transport / transit / ...) sont DEJA compris dans le prix
  ///         unitaire des lignes -> ils ne sont pas re-additionnes, ils servent
  ///         uniquement a produire la mention "CE PRIX S'APPLIQUE : ...".
  ///         C'est le fonctionnement de la facture MZ EXPORT n 49.
  /// false : les frais sont ajoutes au total marchandise.
  feesIncluded Boolean @default(true)

  shippingLabel   String  @default("Transport")
  shippingAmount  Decimal @default(0) @db.Decimal(18, 2)
  transitLabel    String  @default("Transit")
  transitAmount   Decimal @default(0) @db.Decimal(18, 2)
  insuranceLabel  String  @default("Assurance")
  insuranceAmount Decimal @default(0) @db.Decimal(18, 2)
  otherFeesLabel  String  @default("Autres frais")
  otherFeesAmount Decimal @default(0) @db.Decimal(18, 2)

  vatMode VatMode @default(NONE)
  vatRate Decimal @default(0) @db.Decimal(6, 3)

  /// Timbre fiscal ajoute APRES la TVA (net a payer = TTC + timbre).
  stampDutyLabel  String  @default("Timbre fiscal")
  stampDutyAmount Decimal @default(0) @db.Decimal(18, 2)

  totalHt   Decimal @default(0) @db.Decimal(18, 2)
  vatAmount Decimal @default(0) @db.Decimal(18, 2)
  totalTtc  Decimal @default(0) @db.Decimal(18, 2)
  netToPay  Decimal @default(0) @db.Decimal(18, 2)

  paidAmount Decimal @default(0) @db.Decimal(18, 2)
  balanceDue Decimal @default(0) @db.Decimal(18, 2)

  /// Taux FIGE au moment de l'enregistrement : 1 unite de `currencyCode` = X TND.
  /// Ne change jamais ensuite, meme si le taux de reference evolue.
  exchangeRateTnd Decimal @default(1) @db.Decimal(18, 6)
  /// Contrevaleur en dinars, calculee une fois et stockee : le tableau de bord
  /// et les rapports agregent ces colonnes en SQL au lieu de convertir en JS.
  netToPayTnd     Decimal @default(0) @db.Decimal(18, 3)
  paidAmountTnd   Decimal @default(0) @db.Decimal(18, 3)
  balanceDueTnd   Decimal @default(0) @db.Decimal(18, 3)

  amountInWords      String @default("")
  priceBreakdownNote String @default("")
  notes              String @default("")

  createdById String?
  confirmedAt DateTime?
  cancelledAt DateTime?

  isDemo Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer          Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  currency          Currency           @relation(fields: [currencyCode], references: [code])
  createdBy         User?              @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items             InvoiceItem[]
  payments          Payment[]
  /// Pieces recues et rattachees a la vente : bon de livraison du transporteur,
  /// facture de transport, pieces douanieres.
  documents         Document[]
  /// Factures de transport couvrant l'expedition de cette vente. Elles donnent
  /// le cout reel d'acheminement, donc la marge nette de l'expedition.
  transportInvoices TransportInvoice[]

  @@index([customerId])
  @@index([status])
  @@index([date])
  /// Requete "factures en retard" : filtre status + dueDate + balanceDue.
  @@index([status, dueDate])
  @@index([domiciliationRef])
  @@map("invoices")
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  productId String?

  position    Int    @default(0)
  reference   String @default("")
  designation String
  description String @default("")
  unit        String @default("")

  quantity        Decimal @db.Decimal(18, 3)
  unitPrice       Decimal @db.Decimal(18, 4)
  discountPercent Decimal @default(0) @db.Decimal(6, 3)
  lineTotal       Decimal @default(0) @db.Decimal(18, 2)

  ngp           String @default("")
  originCountry String @default("")

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@map("invoice_items")
}

// ---------------------------------------------------------------------------
// Paiements
// ---------------------------------------------------------------------------

model Payment {
  id           String        @id @default(cuid())
  invoiceId    String
  amount       Decimal       @db.Decimal(18, 2)
  currencyCode String        @default("EUR")
  date         DateTime      @db.Date
  method       PaymentMethod @default(BANK_TRANSFER)
  reference    String        @default("")
  note         String        @default("")

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Mouvement bancaire dont cet encaissement est issu, quand il vient du
  /// rapprochement plutot que d'une saisie manuelle.
  bankMovementId String?
  bankMovement   BankMovement? @relation(fields: [bankMovementId], references: [id], onDelete: SetNull)

  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  currency  Currency @relation(fields: [currencyCode], references: [code])
  createdBy User?    @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([date])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Fournisseurs (achats en TND)
// ---------------------------------------------------------------------------

model Supplier {
  id          String @id @default(cuid())
  code        String @unique
  companyName String
  contactName String @default("")

  addressLine1 String @default("")
  addressLine2 String @default("")
  postalCode   String @default("")
  city         String @default("")
  country      String @default("Tunisie")

  phone String @default("")
  email String @default("")

  taxId         String @default("")
  tradeRegister String @default("")

  paymentTerms String @default("")
  currencyCode String @default("TND")

  /// Ventilation des achats dans le resultat. Reglee une fois sur la fiche.
  nature SupplierNature @default(DIVERS)

  notes    String  @default("")
  isDemo   Boolean @default(false)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  currency  Currency   @relation(fields: [currencyCode], references: [code])
  purchases Purchase[]

  @@index([companyName])
  @@map("suppliers")
}

// ---------------------------------------------------------------------------
// Factures d'achat (TND)
// ---------------------------------------------------------------------------

model Purchase {
  id     String        @id @default(cuid())
  number String        @unique
  status InvoiceStatus @default(DRAFT)

  /// Numero de la facture emise par le fournisseur
  supplierReference String @default("")

  supplierId String
  date       DateTime  @db.Date
  dueDate    DateTime? @db.Date

  currencyCode String @default("TND")
  paymentTerms String @default("")

  itemsTotal    Decimal @default(0) @db.Decimal(18, 3)
  discountTotal Decimal @default(0) @db.Decimal(18, 3)

  shippingLabel   String  @default("Transport")
  shippingAmount  Decimal @default(0) @db.Decimal(18, 3)
  otherFeesLabel  String  @default("Autres frais")
  otherFeesAmount Decimal @default(0) @db.Decimal(18, 3)

  vatMode VatMode @default(RATE)
  vatRate Decimal @default(19) @db.Decimal(6, 3)

  stampDutyLabel  String  @default("Timbre fiscal")
  stampDutyAmount Decimal @default(0) @db.Decimal(18, 3)

  /// Retenue a la source prelevee sur le reglement du fournisseur.
  ///
  /// NE REDUIT PAS `netToPay` : la charge reste le montant facture. La retenue
  /// est prelevee au moment du paiement — le fournisseur recoit
  /// `netToPay - withholdingAmount`, le solde est reverse a l'administration.
  /// C'est pourquoi elle vit a cote des totaux et n'entre pas dans leur calcul.
  withholdingLabel  String  @default("Retenue à la source")
  withholdingAmount Decimal @default(0) @db.Decimal(18, 3)

  totalHt   Decimal @default(0) @db.Decimal(18, 3)
  vatAmount Decimal @default(0) @db.Decimal(18, 3)
  totalTtc  Decimal @default(0) @db.Decimal(18, 3)
  netToPay  Decimal @default(0) @db.Decimal(18, 3)

  paidAmount Decimal @default(0) @db.Decimal(18, 3)
  balanceDue Decimal @default(0) @db.Decimal(18, 3)

  /// Achats normalement en TND (taux = 1), mais la colonne existe pour
  /// permettre un achat en devise sans changer le reste du code.
  exchangeRateTnd Decimal @default(1) @db.Decimal(18, 6)
  netToPayTnd     Decimal @default(0) @db.Decimal(18, 3)
  paidAmountTnd   Decimal @default(0) @db.Decimal(18, 3)
  balanceDueTnd   Decimal @default(0) @db.Decimal(18, 3)

  notes String @default("")

  createdById String?
  confirmedAt DateTime?
  cancelledAt DateTime?

  isDemo Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplier  Supplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  currency  Currency          @relation(fields: [currencyCode], references: [code])
  createdBy User?             @relation("PurchaseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items     PurchaseItem[]
  payments  PurchasePayment[]
  /// Pieces recues et rattachees a l'achat : facture fournisseur scannee
  /// (le seul document ayant valeur probante), justificatifs de reglement.
  documents Document[]

  @@index([supplierId])
  @@index([status])
  @@index([date])
  @@map("purchases")
}

model PurchaseItem {
  id         String  @id @default(cuid())
  purchaseId String
  productId  String?

  position    Int    @default(0)
  reference   String @default("")
  designation String
  description String @default("")
  unit        String @default("")

  quantity        Decimal @db.Decimal(18, 3)
  unitPrice       Decimal @db.Decimal(18, 4)
  discountPercent Decimal @default(0) @db.Decimal(6, 3)
  lineTotal       Decimal @default(0) @db.Decimal(18, 3)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([purchaseId])
  @@map("purchase_items")
}

model PurchasePayment {
  id           String        @id @default(cuid())
  purchaseId   String
  amount       Decimal       @db.Decimal(18, 3)
  currencyCode String        @default("TND")
  date         DateTime      @db.Date
  method       PaymentMethod @default(BANK_TRANSFER)
  reference    String        @default("")
  note         String        @default("")

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Mouvement bancaire dont ce reglement est issu, quand il vient du
  /// rapprochement plutot que d'une saisie manuelle.
  bankMovementId String?
  bankMovement   BankMovement? @relation(fields: [bankMovementId], references: [id], onDelete: SetNull)

  purchase  Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  currency  Currency @relation(fields: [currencyCode], references: [code])
  createdBy User?    @relation("PurchasePaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([purchaseId])
  @@index([date])
  @@map("purchase_payments")
}

// ---------------------------------------------------------------------------
// Transport (TND)
//
// POURQUOI UN MODULE A PART. Une societe de transport n'est pas un
// fournisseur : elle ne vend aucune marchandise, rien n'entre en stock, et sa
// facture ne se comprend qu'attachee a une EXPEDITION — donc a une facture de
// vente. La confondre avec un fournisseur de fouta melangeait deux metiers
// dans une meme liste et faussait la ventilation du resultat.
//
// Ce module est volontairement plus simple que les achats : pas de lignes
// d'articles, pas de mouvement de stock. Un transporteur, une expedition, un
// montant, et la facture originale en piece jointe.
// ---------------------------------------------------------------------------

model Carrier {
  id          String @id @default(cuid())
  code        String @unique
  companyName String
  contactName String @default("")

  addressLine1 String @default("")
  addressLine2 String @default("")
  postalCode   String @default("")
  city         String @default("")
  country      String @default("Tunisie")

  phone String @default("")
  email String @default("")

  taxId         String @default("")
  tradeRegister String @default("")

  paymentTerms String @default("")
  currencyCode String @default("TND")

  notes    String  @default("")
  isDemo   Boolean @default(false)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  currency Currency           @relation(fields: [currencyCode], references: [code])
  invoices TransportInvoice[]

  @@index([companyName])
  @@map("carriers")
}

model TransportInvoice {
  id     String        @id @default(cuid())
  number String        @unique
  status InvoiceStatus @default(DRAFT)

  /// Numero de la facture emise par le transporteur.
  carrierReference String @default("")

  carrierId String
  date      DateTime  @db.Date
  dueDate   DateTime? @db.Date

  /// Reference de l'expedition telle que le transporteur la designe
  /// (« wida 21 », « SEMI 14 »). C'est la cle de rapprochement avec la vente.
  shipmentRef String  @default("")
  /// Facture de vente couverte, quand le rapprochement est etabli. Nullable :
  /// une facture de transport peut arriver avant que la vente soit saisie.
  invoiceId   String?

  currencyCode String @default("TND")
  paymentTerms String @default("")

  /// Trois montants nommes plutot que des lignes d'articles : c'est ce que
  /// portent reellement les factures de transport recues.
  transportLabel  String  @default("Transport")
  transportAmount Decimal @default(0) @db.Decimal(18, 3)
  transitLabel    String  @default("Transit et douane")
  transitAmount   Decimal @default(0) @db.Decimal(18, 3)
  otherFeesLabel  String  @default("Autres frais")
  otherFeesAmount Decimal @default(0) @db.Decimal(18, 3)

  vatMode VatMode @default(NONE)
  vatRate Decimal @default(19) @db.Decimal(6, 3)

  stampDutyLabel  String  @default("Timbre fiscal")
  stampDutyAmount Decimal @default(0) @db.Decimal(18, 3)

  totalHt   Decimal @default(0) @db.Decimal(18, 3)
  vatAmount Decimal @default(0) @db.Decimal(18, 3)
  totalTtc  Decimal @default(0) @db.Decimal(18, 3)
  netToPay  Decimal @default(0) @db.Decimal(18, 3)

  paidAmount Decimal @default(0) @db.Decimal(18, 3)
  balanceDue Decimal @default(0) @db.Decimal(18, 3)

  /// Transport facture en dinars (taux = 1), mais la colonne existe pour
  /// qu'un transporteur etranger n'oblige pas a rouvrir le modele.
  exchangeRateTnd Decimal @default(1) @db.Decimal(18, 6)
  netToPayTnd     Decimal @default(0) @db.Decimal(18, 3)
  paidAmountTnd   Decimal @default(0) @db.Decimal(18, 3)
  balanceDueTnd   Decimal @default(0) @db.Decimal(18, 3)

  notes String @default("")

  createdById String?
  confirmedAt DateTime?
  cancelledAt DateTime?

  isDemo Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  carrier   Carrier            @relation(fields: [carrierId], references: [id], onDelete: Restrict)
  invoice   Invoice?           @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  currency  Currency           @relation(fields: [currencyCode], references: [code])
  createdBy User?              @relation("TransportInvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  payments  TransportPayment[]
  /// Pieces recues : facture du transporteur, bon de livraison, justificatif
  /// de reglement. Ce sont elles qui ont valeur probante.
  documents Document[]

  @@index([carrierId])
  @@index([invoiceId])
  @@index([status])
  @@index([date])
  @@index([shipmentRef])
  @@map("transport_invoices")
}

model TransportPayment {
  id                 String        @id @default(cuid())
  transportInvoiceId String
  amount             Decimal       @db.Decimal(18, 3)
  currencyCode       String        @default("TND")
  date               DateTime      @db.Date
  method             PaymentMethod @default(BANK_TRANSFER)
  reference          String        @default("")
  note               String        @default("")

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bankMovementId String?
  bankMovement   BankMovement? @relation(fields: [bankMovementId], references: [id], onDelete: SetNull)

  transportInvoice TransportInvoice @relation(fields: [transportInvoiceId], references: [id], onDelete: Cascade)
  currency         Currency         @relation(fields: [currencyCode], references: [code])
  createdBy        User?            @relation("TransportPaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([transportInvoiceId])
  @@index([date])
  @@map("transport_payments")
}

// ---------------------------------------------------------------------------
// Mouvements de stock
// ---------------------------------------------------------------------------

/// Le signe applique au stock est deduit du type (cf. src/lib/stock.ts) :
/// entrees  -> PURCHASE_IN, ADJUST_IN, CUSTOMER_RETURN
/// sorties  -> SALE_OUT, ADJUST_OUT, SUPPLIER_RETURN
enum StockMovementType {
  PURCHASE_IN
  SALE_OUT
  ADJUST_IN
  ADJUST_OUT
  CUSTOMER_RETURN
  SUPPLIER_RETURN
}

enum StockReferenceType {
  PURCHASE
  INVOICE
  MANUAL
}

model StockMovement {
  id         String            @id @default(cuid())
  productId  String
  type       StockMovementType
  /// Toujours positif : le sens est porte par `type`.
  quantity   Decimal           @db.Decimal(18, 3)
  /// Stock du produit APRES application du mouvement (piste d'audit).
  stockAfter Decimal           @db.Decimal(18, 3)

  referenceType StockReferenceType @default(MANUAL)
  referenceId   String?
  reference     String             @default("")

  date   DateTime @db.Date
  note   String   @default("")
  userId String?

  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([date])
  @@index([type])
  @@index([referenceType, referenceId])
  @@map("stock_movements")
}

// ---------------------------------------------------------------------------
// Pieces jointes (documents recus de tiers)
// ---------------------------------------------------------------------------

/// Document original rattache a un achat OU a une vente.
///
/// REGLE : le contenu est stocke en base (`content`), pas sur le disque. A
/// l'echelle de MZ EXPORT (quelques dizaines de pieces par an, ~500 Ko
/// chacune) le surcout est negligeable, et un seul `pg_dump` sauvegarde
/// l'integralite des justificatifs avec la comptabilite. Un dossier separe
/// qu'on oublie de copier fait perdre les pieces en gardant les ecritures.
///
/// Exactement UN des deux rattachements (`purchaseId`, `invoiceId`) est
/// renseigne. La contrainte est posee en SQL dans la migration, parce que
/// Prisma ne sait pas l'exprimer.
model Document {
  id   String       @id @default(cuid())
  kind DocumentKind @default(OTHER)

  fileName  String
  mimeType  String
  sizeBytes Int
  content   Bytes

  /// Reference portee par le document lui-meme (n de BL, n de cheque...),
  /// saisie a l'upload : c'est elle qui sert aux recherches.
  reference String @default("")
  note      String @default("")

  /// Un document a EXACTEMENT un parent parmi les trois. La base le garantit
  /// par une contrainte CHECK que Prisma ne sait pas exprimer.
  purchaseId         String?
  invoiceId          String?
  transportInvoiceId String?

  uploadedById String?
  createdAt    DateTime @default(now())

  purchase         Purchase?         @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  invoice          Invoice?          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  transportInvoice TransportInvoice? @relation(fields: [transportInvoiceId], references: [id], onDelete: Cascade)
  uploadedBy       User?             @relation("DocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([purchaseId])
  @@index([invoiceId])
  @@index([transportInvoiceId])
  @@index([kind])
  @@map("documents")
}

/// Mouvement releve sur un compte bancaire, importe depuis un fichier de la
/// banque.
///
/// POURQUOI CETTE TABLE. Les fournisseurs sont regles par ACOMPTES sur compte
/// courant : 96 % des virements sont des montants ronds qui ne correspondent a
/// aucune facture precise. Rapprocher demande donc un geste humain — c'est
/// l'objet de l'ecran de rapprochement. Sans cette table, ce travail se refait
/// entierement a chaque fois, de memoire et sur des relevés papier.
model BankMovement {
  id String @id @default(cuid())

  /// Compte d'origine : « ATB », « ZITOUNA ».
  bank         String
  date         DateTime  @db.Date
  valueDate    DateTime? @db.Date
  label        String
  reference    String    @default("")
  /// Negatif pour un debit, positif pour un credit.
  amount       Decimal   @db.Decimal(18, 3)
  currencyCode String    @default("TND")

  /// Empreinte du mouvement (banque + date + montant + reference + libelle).
  /// Unique : reimporter le meme releve n'introduit aucun doublon.
  fingerprint String @unique

  status BankMovementStatus @default(PENDING)

  /// Renseigne quand le mouvement n'est pas un reglement fournisseur :
  /// « salaire », « transfert interne », « frais bancaires », « impots »...
  category String @default("")
  note     String @default("")

  importedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  payments          Payment[]
  purchasePayments  PurchasePayment[]
  transportPayments TransportPayment[]

  @@index([status])
  @@index([date])
  @@index([bank])
  @@map("bank_movements")
}

enum BankMovementStatus {
  /// A traiter.
  PENDING
  /// Rattache a un ou plusieurs reglements.
  ATTRIBUTED
  /// Classe volontairement : ne concerne pas les fournisseurs.
  IGNORED
}
